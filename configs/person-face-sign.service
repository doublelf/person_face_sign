[Unit]
Description=Person Face Sign - Hailo-8 Edge Pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seeed
WorkingDirectory=/home/seeed/person_face_sign
ExecStart=/usr/bin/python3 /home/seeed/person_face_sign/apps/m4_run.py \
  --source usb:/dev/video0 \
  --enable-api --api-port 8080 \
  --enable-metrics --metrics-port 9090 \
  --db /home/seeed/person_face_sign/data/gallery.db \
  --faiss /home/seeed/person_face_sign/data/gallery
Restart=on-failure
RestartSec=10
WatchdogSec=30
# 资源限制
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target